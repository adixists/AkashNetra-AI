# Secrets and machine-specific settings. Copy to .env (gitignored). NEVER commit .env.

# ERA5 via Copernicus CDS (optional; regime tags fall back to forecast-derived rules
# with a logged message if these are not set).
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Directory with local NCUM/NEPS NetCDF/GRIB2 files for the NCUMSource adapter (optional).
NCUM_DATA_DIR=

# Optional overrides (see config.py):
# AKASHNETRA_CONFIG=config.yaml
# AKASHNETRA_DATA_MODE=synthetic
# AKASHNETRA_API_URL=http://localhost:8000
