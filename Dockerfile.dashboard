# AkashNetra AI dashboard image. NOTE (M0): skeleton only; the app arrives in M5 and the
# image has not been built/tested yet.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AKASHNETRA_HOME=/app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml README.md config.yaml ./
COPY .streamlit ./.streamlit
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "src/akashnetra/dashboard/app.py", \
     "--server.address=0.0.0.0", "--server.port=8501"]
